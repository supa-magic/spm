FROM node:22-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Git config (required for git commit in project scaffolding)
RUN git config --global user.email "test@spm.dev" \
    && git config --global user.name "spm-e2e"

# Provider CLIs
RUN npm i -g @anthropic-ai/claude-code
RUN curl -fsSL https://get.opencode.ai | sh || true
# Cursor = directory-based detection only, no CLI needed

# Scaffold test projects
WORKDIR /app/projects

# React TS (Vite)
RUN npx --yes create-vite react-ts-app --template react-ts \
    && cd react-ts-app && npm install \
    && mkdir -p .claude .opencode .cursor/rules \
    && touch .claude/.gitkeep .opencode/.gitkeep .cursor/rules/.gitkeep \
    && git init && git add -A && git commit -m "init"

# Express backend
RUN npx --yes express-generator express-app \
    && cd express-app && npm install \
    && mkdir -p .claude .opencode .cursor/rules \
    && touch .claude/.gitkeep .opencode/.gitkeep .cursor/rules/.gitkeep \
    && git init && git add -A && git commit -m "init"

# Django
RUN python3 -m venv /app/venvs/django \
    && /app/venvs/django/bin/pip install django \
    && mkdir -p django-app \
    && /app/venvs/django/bin/django-admin startproject django_app django-app \
    && cd django-app \
    && mkdir -p .claude .opencode .cursor/rules \
    && touch .claude/.gitkeep .opencode/.gitkeep .cursor/rules/.gitkeep \
    && git init && git add -A && git commit -m "init"

WORKDIR /app/spm
